# Google Lens
ro.com.google.lens.oem_camera_package=com.android.camera

# Framework allowlists
persist.vendor.camera.privapp.list=com.android.camera,org.lineageos.aperture
vendor.camera.aux.packagelist=com.android.camera,com.xiaomi.runin,com.xiaomi.cameratest,com.xiaomi.factory.mmi,org.codeaurora.snapcam

# HyperOS / MIVI Camera Properties
vendor.camera.support.mivi=true
hypercamera.disable_app_default_config=true

# MiuiCamera
ro.miui.notch=1
ro.miui.ui.version.name=V816
ro.miui.ui.version.code=816
