soong_namespace {
    imports: [
        "device/xiaomi/sm8635-common",
        "hardware/xiaomi",
    ],
}

android_app_import {
    name: "MiuiCamera",
    apk: "prebuilt/priv-app/MiuiCamera/MiuiCamera.apk",
    presigned: true,
    preprocessed: true,
    skip_preprocessed_apk_checks: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
    overrides: [
        "Aperture",
        "Camera2",
        "Snap",
    ],
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi",
    srcs: ["prebuilt/lib64/libcamera_algoup_jni.xiaomi.so"],
    shared_libs: ["libgui_shim_miuicamera"],
    system_ext_specific: true,
    compile_multilib: "64",
}

cc_prebuilt_library_shared {
    name: "libcamera_mianode_jni.xiaomi",
    srcs: ["prebuilt/lib64/libcamera_mianode_jni.xiaomi.so"],
    shared_libs: ["libgui_shim_miuicamera"],
    system_ext_specific: true,
    compile_multilib: "64",
}

cc_prebuilt_library_shared {
    name: "libmicampostproc_client",
    srcs: ["prebuilt/lib64/libmicampostproc_client.so"],
    system_ext_specific: true,
    compile_multilib: "64",
}

cc_prebuilt_library_shared {
    name: "vendor.xiaomi.hardware.campostproc@1.0",
    srcs: ["prebuilt/lib64/vendor.xiaomi.hardware.campostproc@1.0.so"],
    system_ext_specific: true,
    compile_multilib: "64",
}
