soong_namespace {
    imports: [
        "device/xiaomi/miuicamera-uke",
    ],
}

android_app_import {
    name: "MiuiCamera",
    owner: "xiaomi/miuicamera-uke",
    apk: "prebuilt/priv-app/MiuiCamera/MiuiCamera.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    overrides: [
        "Aperture",
        "Camera2",
        "Snap",
    ],
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi",
    owner: "xiaomi/miuicamera-uke",
    srcs: ["prebuilt/lib64/libcamera_algoup_jni.xiaomi.so"],
    shared_libs: [
        "libgui_shim_miuicamera",
        "libandroid",
        "libandroid_runtime",
        "libbase",
        "libbinder",
        "libcamera_client",
        "libcamera_metadata",
        "libcutils",
        "libgui",
        "liblog",
        "libmedia_jni_utils",
        "libnativehelper",
        "libnativewindow",
        "libui",
        "libutils",
        "libvndksupport",
    ],
    compile_multilib: "64",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libcamera_mianode_jni.xiaomi",
    owner: "xiaomi/miuicamera-uke",
    srcs: ["prebuilt/lib64/libcamera_mianode_jni.xiaomi.so"],
    shared_libs: [
        "libgui_shim_miuicamera",
        "libandroid",
        "libbinder",
        "libcamera_client",
        "libcamera_metadata",
        "libcutils",
        "libgui",
        "liblog",
        "libmedia_jni_utils",
        "libui",
        "libutils",
        "libvndksupport",
        "libxml2",
    ],
    compile_multilib: "64",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libmicampostproc_client",
    owner: "xiaomi/miuicamera-uke",
    srcs: ["prebuilt/lib64/libmicampostproc_client.so"],
    shared_libs: [
        "libEGL",
        "libGLESv2",
        "libcamera_client",
        "libcamera_metadata",
        "libcutils",
        "libfmq",
        "libgui",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libmedia_jni_utils",
        "libnativehelper",
        "libnativewindow",
        "libui",
        "libutils",
        "vendor.xiaomi.hardware.campostproc@1.0",
    ],
    compile_multilib: "64",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "vendor.xiaomi.hardware.campostproc@1.0",
    owner: "xiaomi/miuicamera-uke",
    srcs: ["prebuilt/lib64/vendor.xiaomi.hardware.campostproc@1.0.so"],
    shared_libs: [
        "android.hardware.camera.common@1.0",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    compile_multilib: "64",
    check_elf_files: false,
}
